<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DungeonLife"
        xmlns:views="clr-namespace:DungeonLife.Views"
        xmlns:vm="clr-namespace:DungeonLife.ViewModels"
        x:Class="DungeonLife.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static local:LifeAppSettings.WindowTitle}"
        Background="#101010">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="8"
                Height="40"
                Background="#1f1f1f">
      <Button Content="Run" Command="{Binding RunCommand}" Width="60" />
      <Button Content="Pause" Command="{Binding PauseCommand}" Width="70" />
      <Button Content="Step" Command="{Binding StepCommand}" Width="60" />
      <TextBlock Text="{Binding TimeText}"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0" />
    </StackPanel>
    <Grid ColumnDefinitions="*,280">
      <ScrollViewer Grid.Column="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <views:WorldView x:Name="WorldView" />
      </ScrollViewer>
      <views:DetailsPanel Grid.Column="1" DataContext="{Binding}" />
    </Grid>
  </DockPanel>
</Window>
